#include <iostream>
using namespace std;

struct node {
    int data;
    node *next;
};

struct linkedList {
    node *head = nullptr;
    node *tail = nullptr;

    void addNode(int value) {
        node *newnode = new node{value, nullptr};

        if (head == nullptr) {
            head = newnode;
            tail = newnode;
            tail->next = head;
        } else {
            tail->next = newnode;
            tail = newnode;
            tail->next = head;
        }
    }

    void printList() {
        if (head == nullptr) {
            cout << "List is empty" << endl;
            return;
        }

        node *curr = head;
        do {
            cout << curr->data << " -> ";
            curr = curr->next;
        } while (curr != head);
        cout << "(head: " << head->data << ")" << endl;
    }

    int countNodes() {
        if (head == nullptr) {
            return 0;
        }

        int count = 0;
        node *curr = head;
        do {
            count++;
            curr = curr->next;
        } while (curr != head);

        return count;
    }

    void clearList() {
        if (head == nullptr) return;

        tail->next = nullptr;

        node *curr = head;
        while (curr != nullptr) {
            node *nextNode = curr->next;
            delete curr;
            curr = nextNode;
        }

        head = nullptr;
        tail = nullptr;
    }

    void deleteNode(int val) {
        if (head == nullptr) {
            cout << "List is empty, cannot delete " << val << endl;
            return;
        }

        node *curr = head;
        node *prev = tail;
        bool found = false;

        do {
            if (curr->data == val) {
                found = true;
                break;
            }
            prev = curr;
            curr = curr->next;
        } while (curr != head);

        if (!found) {
            cout << "Value " << val << " not found in the list." << endl;
            return;
        }

        if (head == tail) {
            head = nullptr;
            tail = nullptr;
        } else {
            prev->next = curr->next;

            if (curr == head) {
                head = curr->next;
                tail->next = head;
            }
            if (curr == tail) {
                tail = prev;
                tail->next = head;
            }
        }

        delete curr;
    }
};

int main() {
    linkedList list;

    cout << " Empty List Deletion ===" << endl;
    list.deleteNode(10);

    cout << "\n Missing Value ===" << endl;
    list.addNode(10);
    list.addNode(20);
    list.deleteNode(99);
    list.clearList();

    cout << "\nDeleting Head, Tail, and Only Node " << endl;
    list.addNode(10);
    list.addNode(20);
    list.addNode(30);

    cout << "Initial list: ";
    list.printList();
    cout << "Count: " << list.countNodes() << endl;

    cout << "\nDeleting head (10)..." << endl;
    list.deleteNode(10);
    cout << "List: ";
    list.printList();
    cout << "Count: " << list.countNodes() << endl;

    cout << "\nDeleting tail (30)..." << endl;
    list.deleteNode(30);
    cout << "List: ";
    list.printList();
    cout << "Count: " << list.countNodes() << endl;

    cout << "\nDeleting last node (20)..." << endl;
    list.deleteNode(20);
    cout << "List: ";
    list.printList();
    cout << "Count: " << list.countNodes() << endl;

    if (list.head == nullptr && list.tail == nullptr) {
        cout << "Verified: Both head and tail are nullptr." << endl;
    }

    cout << "\n Duplicate Handling " << endl;
    list.addNode(10);
    list.addNode(20);
    list.addNode(20);
    list.addNode(30);

    cout << "Initial list: ";
    list.printList();
    cout << "Count: " << list.countNodes() << endl;

    cout << "\nDeleting 20 once" << endl;
    list.deleteNode(20);
    cout << "List: ";
    list.printList();
    cout << "Count: " << list.countNodes() << endl;

    list.clearList();
    return 0;
}
