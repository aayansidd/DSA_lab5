#include <iostream>
using namespace std;

struct node {
    node *head;
    node *prev;
    node *next;
    int data;
};

struct linkedList {
    node *head = nullptr;
    node *prev = nullptr;
    node *curr = nullptr;
    node *next = nullptr;
    node *tail = nullptr;

    void addNode(int data) {
        node *newnode = new node;
        newnode->data = data;
        newnode->next = nullptr;

        if (head == nullptr) {
            head = newnode;
            tail = newnode;
            newnode->prev = nullptr;

        } else {
            tail->next = newnode;
            newnode->prev = tail;
            tail = newnode;


        }
    }

    void printForward() {
        curr = head;
        while (curr != nullptr) {
            cout << curr->data << "->";
            curr = curr->next;
        }
        cout << "NULLPTR" << endl;

    }

    void printReverse() {
        curr = tail;

        while (curr != nullptr) {
            cout << curr->data << "<-";
            curr = curr->prev;
        }
        cout << "NULLPTR" << endl;

    }

    void clearList() {
        curr = head;
        while (curr->next != nullptr) {
            next = curr->next;
            delete curr;
            curr = next;
        }
        head = nullptr;
        tail = nullptr;
    }
};


int main() {
    linkedList *myList = new linkedList;

    int n, data;
    cout << "Enter n: ";
    cin >> n;

    for (int i = 0; i < n; i++) {
        cout << "Enter data: ";
        cin >> data;
        myList->addNode(data);
    }
    myList->printReverse();
    myList->printForward();

};
